# ============================================================
# Office_Agent 环境变量配置（生产）
# 用法：cp deploy/office-agent.env.example deploy/office-agent.env
#       然后填入真实值，chmod 600
# 注意：config.py 中所有配置均有默认值，此文件只写需要覆盖的项
# ============================================================

# ── 服务监听 ──────────────────────────────────────────────
# 使用 nginx 反代时建议 127.0.0.1；直接对外暴露则 0.0.0.0
APP_HOST=0.0.0.0
APP_PORT=8000

# ── MySQL（沿用 172.16.8.225 中间件，数据已在库中）─────────
MYSQL_HOST=172.16.8.225
MYSQL_PORT=30316
MYSQL_DB=office_agent_ai
MYSQL_USER=test-admin
MYSQL_PASSWORD=__CHANGE_ME_MYSQL__

# ── Redis（沿用 172.16.8.225 中间件）──────────────────────
REDIS_HOST=172.16.8.225
REDIS_PORT=30689
REDIS_DB=0
REDIS_PASSWORD=__CHANGE_ME_REDIS__

# ── LLM（智谱 BigModel，Anthropic 兼容端点）───────────────
LLM_BASE_URL=https://open.bigmodel.cn/api/anthropic
LLM_API_KEY=__CHANGE_ME_ZHIPU_KEY__
LLM_MODEL=glm-5.2
LLM_MAX_TOKENS=16384
LLM_TIMEOUT=60
# 全局 LLM 并发上限：会议室多子任务并发时防 429 限流（可慢不能断）
LLM_CONCURRENCY=2

# ── 工作区根目录（仓库 clone / 上传文件 / 协作方案落盘）────
# 默认 <项目根>/workspaces，一般无需覆盖
# WORKSPACE_ROOT=/data/office-agent/workspaces

# ── 调试开关（生产建议 false）─────────────────────────────
DEBUG=false
