# ============================================================
# Office_Agent .gitignore
# 原则:代码/文档/配置样例入库;密钥、运行时数据、本地备份一律排除
# ============================================================

# ── 密钥与环境(最重要,严禁入库) ─────────────
deploy/office-agent.env
.env
*.local

# ── 运行时数据(服务器上重新生成) ─────────────
workspaces/          # git 仓库 clone / collab_docs / uploads
uploads/             # start.py 按需创建的上传目录
logs/
*.log

# ── Python ──────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ── 前端 .bak 备份链(本地回滚机制,不入库) ─────
*.bak-*

# ── 工具与编辑器缓存 ───────────────────────
.playwright-mcp/
.claude/
.idea/
.vscode/

# ── 系统文件 ─────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
